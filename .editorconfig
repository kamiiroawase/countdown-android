root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java,kt}]
indent_size = 4
indent_style = space

[*.kt]
# noinspection EditorConfigKeyCorrectness
ktlint_standard_function-naming = disabled

[*.xml]
indent_size = 4
indent_style = space
